{
  "extends": "magic-tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    // TypeScript 7 (tsgo) does not auto-include @types packages with this
    // config shape, so `process.env` and `node:*` fail to resolve without it
    // even though @types/node is installed.
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
