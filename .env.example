# Copy to `.env.local`. Every variable here is optional — the site builds,
# boots and runs with the file absent.

# PostHog project token (`phc_...`) for browser analytics and error tracking.
# Without it `magic-observability` hands back a no-op client: every method
# exists, nothing is sent, nothing is logged. Set it in Vercel to switch
# telemetry on for the deployed site.
NEXT_PUBLIC_POSTHOG_KEY=

# Defaults to https://us.i.posthog.com. Only set for an EU or self-hosted
# project.
NEXT_PUBLIC_POSTHOG_HOST=

# Server-side token, read first by `instrumentation.ts` and the API routes.
# Leave empty unless the server should report to a different PostHog project
# than the browser — the NEXT_PUBLIC_ pair above is the fallback.
POSTHOG_KEY=
POSTHOG_HOST=

# Origin for the generated assets (`curriculum.pdf`). Defaults to
# https://assets.gabrieltaveira.dev, which is what production uses.
ASSETS_ORIGIN=
